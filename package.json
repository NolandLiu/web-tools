{
  "name": "web-tools",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build && node scripts/generate-static-pages.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npm run schema:build --silent && node --test --test-concurrency=1 tests/*.test.mjs",
    "inventory:generate": "node scripts/generate-migration-inventory.mjs",
    "catalog:validate": "npm run schema:build --silent && node scripts/validate-catalog.mjs",
    "catalog:build": "npm run schema:build --silent && node scripts/generate-catalog-artifact.mjs && node scripts/generate-search-index.mjs",
    "schema:build": "npm run build --workspace @godeskhub/catalog-schema",
    "verify:build": "node scripts/verify-build.mjs",
    "verify": "npm run lint && npm run catalog:validate && npm run catalog:build && npm run test && npm run build && npm run verify:build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "typescript-eslint": "^8.64.0"
  }
}
